# 复制为 .env 后，在本机填写真实值；请勿提交 .env。
LLM_PROVIDER=DeepSeek
LLM_API_KEY=YOUR_DEEPSEEK_API_KEY
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 本地前端允许访问的地址；部署时按实际前端域名补充。
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8787,http://localhost:5173,http://localhost:8787

# 首次启动会下载该本地嵌入模型。
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
